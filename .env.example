# Copiá este archivo a .env y completá las keys. El .env NUNCA se sube a git.

# --- Pinecone ---
PINECONE_API_KEY=tu-key-de-pinecone
# Nombre del índice serverless (aws/us-east-1, dimensión 1536, coseno).
INDEX_NAME=pre-entrega-4
# Todos los vectores van a este namespace, nunca al namespace por defecto.
PINECONE_NAMESPACE=caudal-docs

# --- Embeddings (API compatible con OpenAI) ---
OPENAI_API_KEY=tu-key-de-openai-o-gemini
# Opcional: endpoint alternativo compatible con OpenAI. Para usar Gemini gratis:
#   OPENAI_API_KEY=<tu key de Gemini>
#   OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# OPENAI_BASE_URL=
# Default: gemini-embedding-001 si hay OPENAI_BASE_URL, text-embedding-3-small si no.
# EMBEDDING_MODEL=
# Solo si agregás generación de respuestas (no lo usa la recuperación).
# OPENAI_MODEL=gpt-4o-mini
